# Claude Code 本地配置
.claude/

# Files 目录下的用户上传文件
Files/*
!Files/.gitkeep

# SSL 证书
SSL/*
!SSL/.gitkeep

# 环境变量配置（包含敏感信息，不提交）
.env

# 实际使用的 docker-compose 配置（端口可能因部署环境不同而调整）
# 以 docker-compose.example.yml 作为模板
docker-compose.yml

# Node.js 依赖
node_modules/
upload-server/node_modules/

# 测试覆盖率报告
upload-server/coverage/

# 测试临时文件
upload-server/test-uploads/
